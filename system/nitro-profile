#!/bin/sh
# Troca o perfil térmico da Acer (acer_wmi predator_v4). Chamado pela extensão Nitro via pkexec.
f=/sys/firmware/acpi/platform_profile
case "$1" in
    low-power|quiet|balanced|balanced-performance|performance) ;;
    *) echo "perfil inválido: $1" >&2; exit 2 ;;
esac
grep -qw -- "$1" /sys/firmware/acpi/platform_profile_choices || { echo "perfil não suportado: $1" >&2; exit 3; }
printf '%s' "$1" > "$f"
