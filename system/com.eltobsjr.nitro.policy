<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <action id="com.eltobsjr.nitro.profile">
    <description>Trocar o modo de desempenho do Acer Nitro</description>
    <message>Autenticação necessária para trocar o modo de desempenho</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/bin/nitro-profile</annotate>
  </action>
  <action id="com.eltobsjr.nitro.boost">
    <description>Ligar ou desligar o overclock da GPU do Acer Nitro</description>
    <message>Autenticação necessária para mudar o overclock da GPU</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/bin/nitro-boost</annotate>
  </action>
  <action id="com.eltobsjr.nitro.fan">
    <description>Mudar o modo das ventoinhas do Acer Nitro</description>
    <message>Autenticação necessária para mudar o modo das ventoinhas</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/bin/nitro-fan</annotate>
  </action>
</policyconfig>
